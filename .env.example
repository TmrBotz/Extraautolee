# ─── Ye file copy karke ".env" naam do ───────────────────
# cp .env.example .env
# Phir apni values dalo.

# https://my.telegram.org/apps se lo
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# @BotFather se lo  (/newbot command)
BOT_TOKEN=123456789:AABBccDDeeFFggHH-xxxxxxxxxxxxxxxx

# Leech Group ID — Download+Upload yahan hoga (progress messages yahan)
# Group ka ID lo: @username_bot forward karke ya /id command se
LEECH_GROUP=-100xxxxxxxxxx

# Auto Leech Channel — Upload ke baad media yahan copy hogi (without forward tag)
AUTO_LEECH_CHANNEL=-1002249128593

# MongoDB URI — Duplicate check ke liye
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
